# ==============================================================================
# ADEIP — Backend Environment Configuration Example
# Copy this file to .env and configure values as appropriate for your environment.
# ==============================================================================

# Application Settings
PROJECT_NAME="ADEIP — AI-Assisted Digital Evidence Intelligence Platform"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (Allowed frontend origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/adeip_db

# MongoDB Database Configuration (Async via Motor)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=adeip_db

# Security & Authentication (JWT)
JWT_SECRET_KEY="generate-a-secure-random-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Evidence Vault & Storage
UPLOAD_STORAGE_DIR="storage/evidence_vault"
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB in bytes

# Redis — Background Task Queue (Celery Broker & Result Backend)
# Required for evidence processing background jobs (STEP 12)
REDIS_URL=redis://localhost:6379/0

# Neo4j Graph Database — Relationship Exploration & Investigation Knowledge Graph (STEP 17)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
